# ==============================================================================
# Git Ignore Configuration - AI Research & Weather Agent
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secret Files (Airtight protection)
# ------------------------------------------------------------------------------
# Match .env anywhere in root or any subfolder (e.g., research/.env)
.env
**/.env
.env.*
**/.env.*
*.env
**/*.env

# Explicitly allow safe example / template files
!.env.example
!**/.env.example

# Streamlit local secrets
.streamlit/secrets.toml
**/.streamlit/secrets.toml

# ------------------------------------------------------------------------------
# 2. Python Caches, Bytecode & Build Artifacts
# ------------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# 3. Virtual Environments
# ------------------------------------------------------------------------------
.venv/
**/.venv/
venv/
**/venv/
ENV/
**/ENV/
env/
**/env/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 4. Jupyter Notebook Checkpoints & Data
# ------------------------------------------------------------------------------
.ipynb_checkpoints/
**/.ipynb_checkpoints/
*-checkpoint.ipynb
*.ipynb_checkpoints

# ------------------------------------------------------------------------------
# 5. IDE, Editor & OS Files
# ------------------------------------------------------------------------------
.vscode/
**/.vscode/
.idea/
**/.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ------------------------------------------------------------------------------
# 6. Logs & Runtime Debugging
# ------------------------------------------------------------------------------
*.log
logs/
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
